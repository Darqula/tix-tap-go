{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ClientCredentialsFlow": {
    "ClientId": "",
    "ClientSecret": ""
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "eventservice": {
        "ClusterId": "eventservice",
        "Metadata": {
          "RequiresInternalToken": "true"
        },
        "Match": {
          "Path": "/events/{**catch-all}"
        }
      },
      "eventservice-openapi": {
        "ClusterId": "eventservice",
        "Match": {
          "Path": "/openapi/events.json"
        },
        "Metadata": {
          "RequiresInternalToken": "true"
        },
        "Transforms": [
          {
            "PathSet": "/openapi/v1.json"
          }
        ]
      },
      "venueservice": {
        "ClusterId": "venueservice",
        "Metadata": {
          "RequiresInternalToken": "true"
        },
        "Match": {
          "Path": "/venues/{**catch-all}"
        }
      },
      "venueservice-openapi": {
        "ClusterId": "venueservice",
        "Match": {
          "Path": "/openapi/venues.json"
        },
        "Metadata": {
          "RequiresInternalToken": "true"
        },
        "Transforms": [
          {
            "PathSet": "/openapi/v1.json"
          }
        ]
      }
    },
    "Clusters": {
      "eventservice": {
        "Destinations": {
          "eventservice1": {
            "Address": "https+http://eventservice"
          }
        }
      },
      "venueservice": {
        "Destinations": {
          "venueservice1": {
            "Address": "https+http://venueservice"
          }
        }
      }
    }
  }
}
