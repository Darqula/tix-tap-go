{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "eventservice": {
        "ClusterId": "eventservice",
        "Match": {
          "Path": "/events/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "eventservice": {
        "Destinations": {
          "eventservice1": {
            "Address": "http://localhost:5189/"
          }
        }
      }
    }
  }
}
